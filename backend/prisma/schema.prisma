// ── Optometría ───────────────────────────────────────

model OptometriaInforme {
  id         String      @id @default(cuid())
  consultaId String      @unique
  consulta   ConsultaHCE @relation(fields: [consultaId], references: [id], onDelete: Cascade)

  tipo        String  @default("INTEGRAL") // Formato único; legacy TAMIZAJE se renderiza como Integral
  procedencia String?
  hcNumero    String? // Campo legacy del formato Tamizaje; ya no se captura

  // Rx en uso (gafas actuales) — fórmula + columnas AV, ADD, AV VP, OBS
  rxUsoOd     String?
  rxUsoOdAv   String?
  rxUsoOdAdd  String?
  rxUsoOdAvVp String?
  rxUsoOdObs  String?
  rxUsoOi     String?
  rxUsoOiAv   String?
  rxUsoOiAdd  String?
  rxUsoOiAvVp String?
  rxUsoOiObs  String?
  rxUsoAo     String?
  rxUsoAoAv   String?
  rxUsoAoAdd  String?
  rxUsoAoAvVp String?
  rxUsoAoObs  String?
  tipoLente   String?

  // Agudeza visual (V.L., P.H., V.P., OBS por ojo) + optotipo (Snellen | LOGMAR)
  avOptotipo String?
  avOdVl     String?
  avOdPh     String?
  avOdVp     String?
  avOdObs    String?
  avOiVl     String?
  avOiPh     String?
  avOiVp     String?
  avOiObs    String?
  avAoVl     String?
  avAoPh     String?
  avAoVp     String?
  avAoObs    String?

  // Rx final (columna principal = fórmula) — AV VL, ADD, AV VP, DNP, ALT
  rxFinalOd    String?
  rxFinalOdAvVl String?
  rxFinalOdAdd  String?
  rxFinalOdAvVp String?
  rxFinalOdDnp  String?
  rxFinalOdAlt  String?
  rxFinalOi    String?
  rxFinalOiAvVl String?
  rxFinalOiAdd  String?
  rxFinalOiAvVp String?
  rxFinalOiDnp  String?
  rxFinalOiAlt  String?
  rxFinalAo    String?
  rxFinalAoAvVl String?
  rxFinalAoAdd  String?
  rxFinalAoAvVp String?
  rxFinalAoDnp  String?
  rxFinalAoAlt  String?

  // Examen motor (fila V.L. según formato oficial): Técnica, P.P.C., O.R., Luz, Versiones
  // (motorVp* se conserva por compatibilidad; el formato ya no usa la fila V.P.)
  motorVlTecnica  String?
  motorVlPpc      String?
  motorVlOr       String?
  motorVlLuz      String?
  motorVlVersiones String?
  motorVpTecnica  String?
  motorVpPpc      String?
  motorVpOr       String?
  motorVpLuz      String?
  motorVpVersiones String?

  // Sensorialidad (VL/VP): Luces de Worth, 6 base superior, Fusión con filtro rojo
  sentVlWorth      String?
  sentVlBaseSup    String?
  sentVlFusionRojo String?
  sentVpWorth      String?
  sentVpBaseSup    String?
  sentVpFusionRojo String?

  // Examen externo por ojo (valores típicos: SIN ALTERACION / N/V)
  extPestanasOd         String?
  extPestanasOi         String?
  extParpadosOd         String?
  extParpadosOi         String?
  extConjuntivaOd       String?
  extConjuntivaOi       String?
  extCorneaOd           String?
  extCorneaOi           String?
  extEscleroticaOd      String?
  extEscleroticaOi      String?
  extIrisOd             String?
  extIrisOi             String?
  extCristalinoOd       String?
  extCristalinoOi       String?
  extPeliculaLacrimalOd String?
  extPeliculaLacrimalOi String?
  extPioOd              String?
  extPioOi              String?
  extPupilaOd           String?
  extPupilaOi           String?

  // Examen externo (versión anterior de un solo valor — se conserva por compatibilidad)
  extPestanas         String?
  extParpados         String?
  extConjuntiva       String?
  extCornea           String?
  extEsclerotica      String?
  extIris             String?
  extCristalino       String?
  extPeliculaLacrimal String?
  extPio              String?
  extPupila           String?

  // Reflejos pupilares / oftalmoscopía / visión al color / campo visual
  reflFotomotor String?
  reflConsensual String?
  oftOd         String?
  oftOi         String?
  colorOd       String?
  colorOi       String?
  cvOd          String?
  cvOi          String?
  cvObs         String?

  // Cierre del informe
  diagnosticoAO    String? // Diagnóstico A.O. (Emetrope, astigmatismo…)
  tratamiento      String? // "Tratamiento" (sección del flujo de atención)
  recomendaciones  String? // Recomendaciones → alimenta la Devolución
  evaluacion       String? // "Evaluar" → nota clínica interna
  observacion      String? // "Observación" → texto libre del Dr.
  disposicion      String?
  notasAdicionales String? // "Notas adicionales → Observaciones" (texto libre del Dr.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

