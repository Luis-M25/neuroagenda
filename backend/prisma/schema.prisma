// ── HCE: recetas, certificados, altas y derivaciones ──

model Receta {
  id             String      @id @default(cuid())
  consultaId     String
  consulta       ConsultaHCE @relation(fields: [consultaId], references: [id], onDelete: Restrict)
  pacienteId     String
  paciente       Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  especialistaId String
  especialista   Especialista @relation(fields: [especialistaId], references: [id], onDelete: Restrict)

  numeroReceta   Int
  fecha          DateTime    @default(now())
  indicaciones   String?
  estadoEnfermedad String?
  diagnostico      String?
  signosAlarma     String?
  recomendacionesNoFarmacologicas String?
  peso             String?
  talla            String?
  alergias         String?
  validezDias      Int?        @default(3)
  firmada        Boolean     @default(false)
  firmadaEn      DateTime?
  archivoPdfUrl  String?
  hashDocumento  String?

  items RecetaItem[]

  createdAt DateTime @default(now())

  @@index([pacienteId, fecha(sort: Desc)])
  @@index([consultaId])
  @@index([especialistaId, numeroReceta])
}

model RecetaItem {
  id           String @id @default(cuid())
  recetaId     String
  receta       Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  medicamento  String
  presentacion String?
  formaFarmaceutica String?
  concentracion String?
  dosis        String?
  via          String?
  frecuencia   String?
  duracion     String?
  cantidad     String?
  cantidadLetras String?
  indicaciones String?
  orden        Int    @default(0)

  @@index([recetaId])
}

model CertificadoMedico {
  id             String      @id @default(cuid())
  consultaId     String
  consulta       ConsultaHCE @relation(fields: [consultaId], references: [id], onDelete: Restrict)
  pacienteId     String
  paciente       Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  especialistaId String
  especialista   Especialista @relation(fields: [especialistaId], references: [id], onDelete: Restrict)

  tipo            String // ASISTENCIA | REPOSO
  motivo          String?
  observaciones   String?
  diasReposo      Int?
  fechaInicio     DateTime?
  fechaFin        DateTime?
  hashDocumento   String?
  archivoPdfUrl   String?

  createdAt DateTime @default(now())

  @@index([pacienteId, createdAt(sort: Desc)])
  @@index([consultaId])
}

model AltaEspecialidad {
  id              String   @id @default(cuid())
  pacienteId      String
  paciente        Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  especialidad    String
  especialistaId  String?
  especialista    Especialista? @relation(fields: [especialistaId], references: [id], onDelete: SetNull)
  usuarioId       String
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  motivo          String
  observacion     String?
  citasCanceladas Int      @default(0)

  createdAt DateTime @default(now())

  @@index([pacienteId, especialidad, createdAt(sort: Desc)])
}

model Derivacion {
  id                   String      @id @default(cuid())
  pacienteId           String
  paciente             Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  consultaId           String?
  consulta             ConsultaHCE? @relation(fields: [consultaId], references: [id], onDelete: SetNull)
  especialistaOrigenId String
  especialistaOrigen   Especialista @relation(fields: [especialistaOrigenId], references: [id], onDelete: Restrict)
  usuarioId            String
  usuario              Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  motivo      String
  prioridad   String  @default("MEDIA")
  observacion String?
  estado      String  @default("PENDIENTE")

  destinos DerivacionDestino[]

  createdAt DateTime @default(now())

  @@index([pacienteId, createdAt(sort: Desc)])
  @@index([estado])
}

model DerivacionDestino {
  id             String     @id @default(cuid())
  derivacionId   String
  derivacion     Derivacion @relation(fields: [derivacionId], references: [id], onDelete: Cascade)
  especialistaId String
  especialista   Especialista @relation(fields: [especialistaId], references: [id], onDelete: Restrict)
  especialidad   String
  estado         String     @default("PENDIENTE")
  citaId         String?
  cita           Cita?      @relation(fields: [citaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([especialistaId, estado])
  @@index([derivacionId])
}

model HcePrivacidadConfig {
  id                    String   @id @default(cuid())
  especialidad          String   @unique
  compartirDiagnosticos Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
