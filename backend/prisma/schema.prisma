model Notificacion {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String // HCE_PENDIENTE | CITA_VENCIDA | TRIAGE_COMPLETADO | INASISTENCIA_CRITICA | PROTOCOLO_CRITICO
  titulo    String
  mensaje   String
  refId     String? // id de la entidad referida (citaId, consultaId, pacienteId)
  refTipo   String? // "cita" | "consulta" | "paciente"
