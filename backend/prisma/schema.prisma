model AuditoriaHCRevision {
  id          String      @id @default(cuid())
  consultaId  String
  consulta    ConsultaHCE @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  auditorId   String
  auditor     Usuario     @relation(fields: [auditorId], references: [id])
  estado      String // REVISADO | REVISADO_CON_OBSERVACIONES
