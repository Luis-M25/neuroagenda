# Base de datos (SQLite para desarrollo local)
DATABASE_URL=file:./dev.db

# JWT — Generar con: openssl rand -hex 64
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-hex-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Puerto del servidor
PORT=3000

# WhatsApp Cloud API — Configurar en Meta Business
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=NOTIFICACIONES-2026
WHATSAPP_API_VERSION=v25.0

# SMTP (opcional, para notificaciones por correo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# CORS — Frontend URL sin slash final
FRONTEND_URL=http://localhost:3001
SOCKET_CORS_ORIGIN=http://localhost:3001
